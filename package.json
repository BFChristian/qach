{
  "name": "qach",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm run contracts:build && pnpm run --parallel --filter api --filter web dev",
    "dev:api": "pnpm --filter api start:dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm run contracts:build && pnpm run --parallel --filter api --filter web build",
    "build:api": "pnpm --filter api build",
    "build:web": "pnpm --filter web build",
    "contracts:build": "pnpm --filter @qach/contracts build",
    "start:prod": "pnpm --filter api start:prod",
    "db:generate": "pnpm --filter api exec prisma generate",
    "db:migrate": "pnpm --filter api exec prisma migrate dev",
    "db:push": "pnpm --filter api exec prisma db push",
    "db:studio": "pnpm --filter api exec prisma studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:restart": "docker compose restart",
    "lint": "pnpm run --parallel --filter api --filter web lint",
    "test": "pnpm --filter api test",
    "test:e2e": "pnpm --filter api test:e2e",
    "clean": "pnpm run --parallel --recursive exec -- rm -rf dist node_modules/.cache"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.30.1"
}
